# ==============================================================================
# NETRONiX Network Portal — Local Environment Configuration (.env.local)
# ==============================================================================

# ─── 1. SUPABASE POSTGRESQL DATABASE ──────────────────────────────────────────
# DATABASE_URL: Connection pooler URI (Port 6543, pgbouncer=true) for fast API queries.
# DIRECT_URL: Direct database connection URI (Port 5432) for running migrations and backups.
#
# 👉 Replace [YOUR-PASSWORD] with your actual Supabase database password.
# 👉 Replace [YOUR-PROJECT-REF] with your Supabase Project Reference (e.g. abcdefghijklmnop).
# 👉 Replace [REGION] with your Supabase region (e.g. eu-central-1, ap-southeast-1).

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/netronix?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/netronix?schema=public"

# ─── 2. ADMIN AUTHENTICATION SECRET ───────────────────────────────────────────
# Cryptographic secret key used to sign and verify administrative session JWT tokens.
# (Pre-generated 256-bit secure key ready for use)
ADMIN_JWT_SECRET="5SlorQ4pM7JYqWd6PHFiv5efxxQehVvTIVgRwIUJm3g="

# ─── 3. RESEND TRANSACTIONAL EMAIL ────────────────────────────────────────────
# API Key from https://resend.com/api-keys to send automated emails to students.
# (In testing, you can use the default sandbox key from your free Resend account)
RESEND_API_KEY="re_MW5VmgcX_MxDYpPt3MjLQsQTgBn1vUrs3"

# The sender address shown on confirmation & resolution emails.
# In Resend sandbox mode, keep "onboarding@resend.dev".
# Once you add your custom domain in Resend, change to e.g. "NETRONiX <noreply@netronix.giki.edu.pk>".
RESEND_FROM_EMAIL="NETRONiX Support <onboarding@resend.dev>"

# ─── 4. APPLICATION BASE URL ──────────────────────────────────────────────────
# Base URL used to build direct tracking links inside student emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
