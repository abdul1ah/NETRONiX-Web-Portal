# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key. Safe to expose — it is gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SERVER ONLY. Bypasses Row Level Security completely.
# Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin portal session ────────────────────────────────────────────────────
# Signs the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# How long an admin stays logged in, in hours. Optional, defaults to 12.
ADMIN_SESSION_HOURS=12
