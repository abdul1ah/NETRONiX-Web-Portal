# Normalise line endings to LF on commit
* text=auto eol=lf

# Force LF for web source files
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf

# Binary files — no line ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.mp4  binary
*.woff2 binary
*.ico  binary
