# "service_role" key. SERVER ONLY. Bypasses Row Level Security completely.
# Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY= eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpocW1zZmJod2tsd3BvamtrcGJnIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NjkwNzU5MiwiZXhwIjoyMTAyNDgzNTkyfQ.gvRPEDKDfBb55w28PvmZ-xR0TJbz9z4jaFg5ScQFIZA

# ─── Admin portal session ────────────────────────────────────────────────────
# Signs the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET= 

# How long an admin stays logged in, in hours. Optional, defaults to 12.
ADMIN_SESSION_HOURS=12
